{
  "advisorModel": "fable",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.file_path | select(endswith(\".rs\"))' | xargs -r cargo fmt --",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "guard-and-guide",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "command": "~/dotfiles/home-manager/agents/statusline.sh",
    "type": "command"
  },
  "theme": "auto",
  "viewMode": "focus"
}
