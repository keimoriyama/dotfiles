{
  "model": "opus[1m]",
  "advisorModel": "fable",
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ]
  },
  "viewMode": "focus",
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/home-manager/claude-code/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "guard-and-guide"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".rs\"))' | xargs -r cargo fmt --"
          }
        ]
      }
    ]
  },
  "theme": "auto"
}
