{
  "advisorModel": "fable",
  "effortLevel": "low",
  "env": {
    "CLAUDE_CODE_CERT_STORE": "bundled,system"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.file_path | select(endswith(\".rs\"))' | xargs -r cargo fmt --",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/path-guard",
            "type": "command"
          }
        ],
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep"
      },
      {
        "hooks": [
          {
            "command": "guard-and-guide",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": true,
    "filesystem": {
      "allowRead": [
        "~/.cabal",
        "~/.cache/cabal",
        "~/.cache/pre-commit",
        "~/.cache/ruff",
        "~/.cache/ty",
        "~/.cache/uv",
        "~/.cargo",
        "~/.claude",
        "~/.config/cabal",
        "~/.config/git",
        "~/.config/uv",
        "~/.local/bin",
        "~/.local/share/uv",
        "~/.local/state/cabal",
        "~/.npm",
        "~/.rustup",
        "~/Library/Caches/pip",
        "~/Library/Caches/typst",
        "~/ghq"
      ],
      "allowWrite": [
        "~/.cabal",
        "~/.cache/cabal",
        "~/.cache/pre-commit",
        "~/.cache/ruff",
        "~/.cache/ty",
        "~/.cache/uv",
        "~/.cargo",
        "~/.local/bin",
        "~/.local/share/uv",
        "~/.local/state/cabal",
        "~/.npm",
        "~/.rustup",
        "~/Library/Caches/pip",
        "~/Library/Caches/typst",
        "~/ghq"
      ],
      "denyRead": [
        "~/",
        "~/.cargo/credentials",
        "~/.cargo/credentials.toml",
        "~/.local/share/uv/credentials"
      ],
      "denyWrite": [
        "~/.cargo/credentials",
        "~/.cargo/credentials.toml",
        "~/.local/share/uv/credentials"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "*"
      ]
    }
  },
  "statusLine": {
    "command": "$HOME/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "auto",
  "viewMode": "focus"
}
