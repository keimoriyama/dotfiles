{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "deny",
      "~/ghq/**": "allow",
      "~/.local/agent-review/**": "allow",
      "~/.claude/skills/**": "allow"
    }
  },
  "mcp": {
    "textlint": {
      "type": "local",
      "command": ["textlint", "--mcp"],
      "enabled": true
    }
  }
}
