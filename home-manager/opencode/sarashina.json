{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["sarashina"],
  "provider": {
    "sarashina": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sarashina",
      "options": {
        "baseURL": "https://api.sarashina.ai/v1",
        "apiKey": "{env:SARASHINA_API_KEY}"
      },
      "models": {
        "sarashina3.2-mini-thinking": {
          "name": "Sarashina3.2 mini thinking",
          "tool_call": false,
          "reasoning": true,
          "limit": { "context": 128000, "output": 8000 }
        }
      }
    }
  },
  "model": "sarashina/sarashina3.2-mini-thinking",
  "small_model": "sarashina/sarashina3.2-mini-thinking",
  "default_agent": "chat",
  "agent": {
    "chat": {
      "mode": "primary",
      "description": "ツールを使わない Sarashina との対話",
      "prompt": "あなたは日本語で丁寧に応答するアシスタントです。ファイルの読み書きやコマンドの実行はできません。質問には会話の中だけで答えてください。",
      "permission": "deny"
    },
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true }
  },
  "permission": "deny",
  "instructions": [],
  "mcp": {},
  "lsp": false,
  "formatter": false,
  "snapshot": false,
  "share": "disabled",
  "autoupdate": false
}
