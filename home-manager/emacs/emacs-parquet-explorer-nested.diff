-fn batch_to_utf8(batch: &arrow_array::RecordBatch) -> Result<Vec<ArrayRef>, String> {
+enum ColumnFormatter<'a> {
+    Utf8(&'a StringArray),
+    Display(ArrayFormatter<'a>),
+}
+
+impl<'a> ColumnFormatter<'a> {
+    fn value(&self, row: usize) -> Cow<'a, str> {
+        match self {
+            Self::Utf8(array) if array.is_null(row) => Cow::Borrowed("null"),
+            Self::Utf8(array) => Cow::Borrowed(array.value(row)),
+            Self::Display(formatter) => Cow::Owned(formatter.value(row).to_string()),
+        }
+    }
+}
+
+/// Cast columns to Utf8 when possible, preserving nested arrays for the display
+/// formatter rather than rejecting the whole batch.
+fn batch_columns(batch: &arrow_array::RecordBatch) -> Vec<ArrayRef> {
