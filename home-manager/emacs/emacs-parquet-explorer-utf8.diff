+    #[test]
+    fn test_truncate_utf8_bytes_preserves_ascii_and_short_text() {
+        assert_eq!(truncate_utf8_bytes("abcdef", 3), "abc");
+        assert_eq!(truncate_utf8_bytes("abcdef", 100), "abcdef");
+        assert_eq!(truncate_utf8_bytes("短い文字列", 100), "短い文字列");
+    }
+
+    #[test]
+    fn test_truncate_utf8_bytes_backs_up_to_char_boundary() {
+        let prefix = "a".repeat(26);
+        let text = format!("{prefix}なxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
+
+        assert_eq!(truncate_utf8_bytes(&text, 27), prefix);
+        assert_eq!(truncate_utf8_bytes(&text, 28), prefix);
+        assert_eq!(truncate_utf8_bytes(&text, 29), format!("{prefix}な"));
+
+        for max_bytes in 0..=text.len() {
+            let truncated = truncate_utf8_bytes(&text, max_bytes);
+            assert!(truncated.len() <= max_bytes);
+            assert!(text.starts_with(truncated));
+            assert!(text.is_char_boundary(truncated.len()));
         }
     }
 
