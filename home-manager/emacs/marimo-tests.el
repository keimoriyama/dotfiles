(ert-deftest marimo-kernel-lifecycle-does-not-conflate-interrupt-and-restart ()
  (marimo-test--buffer
    (let ((marimo--session "old") commands)
      (cl-letf (((symbol-function 'marimo--command)
                 (lambda (p) (push p commands) '(:sessions [])))
                ((symbol-function 'marimo--sync) #'ignore)
                ((symbol-function 'marimo--python) (lambda () "/python")))
        (marimo-interrupt)
        (should (equal marimo--session "old"))
        (should (equal (plist-get (car commands) :kind) "interrupt"))
        (marimo-restart-kernel)
        (should (member "old" marimo--retired-sessions))
        (should (cl-find "restart-session" commands :key (lambda (p) (plist-get p :kind)) :test #'equal))
        (setq marimo--session "new")
        (marimo-stop)
        (should-not marimo--session)
        (should (member "new" marimo--retired-sessions))))))

