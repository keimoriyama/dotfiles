;;; marimo-tests.el --- Marimo Org contract tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(add-to-list 'load-path (file-name-directory (or load-file-name buffer-file-name)))
(load (expand-file-name "marimo-renderer.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)
(load (expand-file-name "marimo.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)

(defmacro marimo-test--buffer (&rest body)
  "Run BODY in a disposable notebook projection."
  (declare (indent 0))
  `(with-temp-buffer
     (marimo-mode)
     (setq-local buffer-file-name "/tmp/marimo-test.py")
     (setq marimo--document '(:version "1" :metadata #s(hash-table)
                                       :appOptions #s(hash-table) :header "" :cells []))
     (let ((inhibit-modification-hooks t))
       (marimo--insert '(:id "a" :name "first" :code "x = 41"))
       (marimo--insert '(:id "b" :name "second" :code "x + 1")))
     (unwind-protect (progn ,@body)
       (set-buffer-modified-p nil)
       (setq buffer-file-name nil))))

(ert-deftest marimo-mode-activation-renders-org-and-preserves-unsaved-edits ()
  (dolist (modified '(nil t))
    (with-temp-buffer
      (unwind-protect
          (progn
            (insert "import marimo\napp = marimo.App()\n")
            (setq buffer-file-name "/tmp/marimo-mode-entry.py")
            (set-buffer-modified-p modified)
            (let (synchronized)
              (cl-letf (((symbol-function 'marimo--connect) #'ignore)
                        ((symbol-function 'marimo--command)
                         (lambda (params)
                           (should (equal (plist-get params :source)
                                          "import marimo\napp = marimo.App()\n"))
                           '(:kind "success" :document
                                   (:version "1" :cells [(:id "a" :name "first" :code "x = 41")]))))
                        ((symbol-function 'marimo--sync) (lambda () (setq synchronized t))))
                (marimo-mode)
                (should synchronized)
                (should (derived-mode-p 'org-mode))
                (should (equal (plist-get (car (marimo--cells)) :code) "x = 41\n"))
                (should (eq modified (buffer-modified-p)))
                (goto-char (point-min))
                (search-forward "x = 41")
                (should-not (org-invisible-p))
                (goto-char (point-min))
                (search-forward "#+attr_marimo:")
                (should (org-invisible-p)))))
        (set-buffer-modified-p nil)
        (setq buffer-file-name nil)))))

(ert-deftest marimo-mode-invalid-notebook-preserves-source ()
  (with-temp-buffer
    (unwind-protect
        (progn
          (insert "not a notebook")
          (setq buffer-file-name "/tmp/marimo-invalid.py")
          (cl-letf (((symbol-function 'marimo--connect) #'ignore)
                    ((symbol-function 'marimo--command) (lambda (_) '(:kind "invalid-syntax"))))
            (should-error (marimo-mode) :type 'user-error)
            (should (equal (buffer-string) "not a notebook"))
            (should-not marimo--document)
            (fundamental-mode)
            (should (equal (buffer-string) "not a notebook"))))
      (set-buffer-modified-p nil)
      (setq buffer-file-name nil))))

(ert-deftest marimo-open-initializes-an-existing-unrendered-mode-buffer-once ()
  (with-temp-buffer
    (unwind-protect
        (progn
          (marimo-mode)
          (setq buffer-file-name "/tmp/marimo-recover.py")
          (insert "import marimo\napp = marimo.App()\n")
          (let ((buffer (current-buffer)) (connections 0))
            (cl-letf (((symbol-function 'find-file-noselect) (lambda (_) buffer))
                      ((symbol-function 'pop-to-buffer) #'ignore)
                      ((symbol-function 'marimo--connect) (lambda () (cl-incf connections)))
                      ((symbol-function 'marimo--command)
                       (lambda (_) '(:kind "success" :document
                                            (:version "1" :cells [(:id "a" :name "first" :code "42")]))))
                      ((symbol-function 'marimo--sync) #'ignore))
              (marimo-open buffer-file-name)
              (should (= (length (marimo--cells)) 1))
              (let ((ui (buffer-string)))
                (marimo-open buffer-file-name)
                (should (equal ui (buffer-string))))
              (should (= connections 1)))))
      (set-buffer-modified-p nil)
      (setq buffer-file-name nil))))

(ert-deftest marimo-cells-roundtrip-and-reject-duplicate-ids ()
  (marimo-test--buffer
    (should-not (org-element-map (org-element-parse-buffer) 'headline #'identity))
    (let ((cells (marimo--cells)))
      (should (equal (mapcar (lambda (c) (plist-get c :id)) cells) '("a" "b")))
      (should (equal (plist-get (car cells) :code) "x = 41\n"))
      (should (equal (plist-get (cadr cells) :name) "second")))
    (should (hash-table-p (plist-get (car (marimo--cells)) :config)))
    (goto-char (plist-get (cadr (marimo--cells)) :begin))
    (search-forward "\"id\":\"b\"")
    (replace-match "\"id\":\"a\"" t t)
    (should-error (marimo--cells) :type 'user-error)))

