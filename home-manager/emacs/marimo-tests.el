(defun marimo-test--wait (predicate)
  "Wait for asynchronous kernel output until PREDICATE succeeds."
  (let ((deadline (+ (float-time) 20)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (unless (funcall predicate)
      (ert-fail (list :kernel marimo--status :executing marimo--executing
                      :outputs marimo--outputs :document (buffer-substring-no-properties (point-min) (point-max)))))))

(ert-deftest marimo-integration-persistent-kernel-org-save-and-errors ()
  (skip-unless (getenv "MARIMO_TEST_SERVER"))
  (let* ((marimo-server-command (list (getenv "MARIMO_TEST_SERVER")))
         (marimo-python-command (getenv "MARIMO_TEST_PYTHON"))
         (file (make-temp-file "marimo-live-" nil ".py"))
         buffer assets)
    (unwind-protect
        (save-window-excursion
          (write-region "import marimo\napp = marimo.App(width='medium')\n\n@app.cell\ndef first():\n    import uuid\n    token = str(uuid.uuid4())\n    x = 41\n    return token, x\n\n@app.cell\ndef second(token, x):\n    print(token)\n    x + 1\n    return\n\nif __name__ == '__main__':\n    app.run()\n" nil file nil 'silent)
          (setq buffer (find-file-noselect file))
          (set-buffer buffer)
          (marimo-mode)
          (let ((connection marimo--connection))
            (marimo-open file)
            (should (eq connection marimo--connection)))
          (let* ((cells (marimo--cells)) (a (plist-get (car cells) :id))
                 (b (plist-get (cadr cells) :id)) session token)
            (marimo-run-all)
            (marimo-test--wait
             (lambda () (let ((s (gethash b marimo--outputs)))
                          (and (equal (plist-get s :status) "idle")
                               (plist-get s :output) (plist-get s :console)))))
            (setq session marimo--session
                  token (plist-get (car (plist-get (gethash b marimo--outputs) :console)) :data))
            (should (string-match-p "42" (buffer-string)))
            (marimo-test--wait (lambda () (not marimo--executing)))
            (goto-char (plist-get (cadr (marimo--cells)) :begin))
            (search-forward "x + 1") (replace-match "x + 2")
            (marimo-run-cell)
            (marimo-test--wait
             (lambda () (let ((s (gethash b marimo--outputs)))
                          (and (equal (plist-get s :status) "idle")
                               (string-match-p "43" (format "%S" (plist-get s :output)))))))
            (should (equal session marimo--session))
            (should (equal token (plist-get (car (plist-get (gethash b marimo--outputs) :console)) :data)))
            (marimo-test--wait (lambda () (not marimo--executing)))
            (should (gethash a marimo--outputs))
            (save-buffer)
            (let ((source (with-temp-buffer (insert-file-contents file) (buffer-string))))
              (should (string-match-p "@app.cell" source))
              (should (string-match-p "width=\"medium\"" source))
              (should-not (string-match-p "RESULTS\\|MARIMO_ID\\|begin_src" source)))
            (goto-char (plist-get (cadr (marimo--cells)) :begin))
            (search-forward "x + 2") (replace-match "1 / 0")
            (marimo-run-cell)
            (marimo-test--wait
             (lambda () (string-match-p "division by zero" (buffer-string))))
            (should (equal session marimo--session))
            (marimo-test--wait (lambda () (not marimo--executing)))
            (goto-char (plist-get (cadr (marimo--cells)) :begin))
            (org-babel-update-block-body
             "import marimo as mo\nmo.Html(\"<table><tr><td>value</td><td>42</td></tr></table><img src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aL1sAAAAASUVORK5CYII='>\")")
            (marimo-run-cell)
            (marimo-test--wait (lambda () (and marimo--assets (not marimo--executing))))
            (should (string-match-p "| value | 42 |" (buffer-string)))
            (should (directory-files marimo--assets nil "\\.png$"))
            (marimo-insert-cell)
            (org-babel-update-block-body "z = x * 2\nz")
            (let ((c (plist-get (car (last (marimo--cells))) :id)))
              (marimo-run-cell)
              (marimo-test--wait
               (lambda () (and (not marimo--executing)
                               (string-match-p "82" (format "%S" (plist-get (gethash c marimo--outputs) :output))))))
              (goto-char (plist-get (car (last (marimo--cells))) :begin))
                  (delete-region (point) (point-max))
              (marimo--sync)
              (should (= (length (marimo--cells)) 2)))
            (goto-char (plist-get (cadr (marimo--cells)) :begin))
            (org-babel-update-block-body "import time\nwhile True:\n    time.sleep(0.05)")
            (marimo-run-cell)
            (marimo-test--wait (lambda () (equal (plist-get (gethash b marimo--outputs) :status) "running")))
            (marimo-interrupt)
            (marimo-test--wait (lambda () (not marimo--executing)))
            (should (equal session marimo--session))
            (goto-char (plist-get (cadr (marimo--cells)) :begin))
            (org-babel-update-block-body "x + 3")
            (marimo-restart-kernel)
            (should (not (equal session marimo--session)))
            (marimo-run-all)
            (marimo-test--wait
             (lambda () (and (not marimo--executing)
                             (string-match-p "44" (format "%S" (plist-get (gethash b marimo--outputs) :output))))))
            (save-buffer)
            (revert-buffer t t)
            (should (derived-mode-p 'marimo-mode))
            (should (= (length (marimo--cells)) 2))
            (should-not (buffer-modified-p))
            (setq assets marimo--assets)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (when assets (delete-directory assets t))
      (delete-file file))))


(defun marimo-test--javascript (widget script)
  "Evaluate SCRIPT in WIDGET while pumping WebKit callbacks."
  (let ((done nil) value deferred (deadline (+ (float-time) 10)))
    (unwind-protect
        (progn
          (redisplay t)
          (xwidget-webkit-execute-script widget
                                         (format "try { eval(%s) } catch (error) { String(error) }"
                                                 (json-serialize script))
                                         (lambda (result) (setq value result done t)))
          (while (and (not done) (< (float-time) deadline))
            (when-let* ((event (read-event nil nil 0.05)))
              (if (and (consp event) (eq (car event) 'xwidget-event))
                  (let ((last-input-event event)) (xwidget-event-handler))
                (push event deferred))))
          (unless done (ert-fail "WebKit JavaScript callback timed out"))
          value)
      (setq unread-command-events (append (nreverse deferred) unread-command-events)))))

(defun marimo-test--web-ready (widget pattern &optional script)
  "Wait for WIDGET to render text matching PATTERN."
  (maphash (lambda (_id record)
             (when (eq widget (plist-get record :widget))
               (goto-char (plist-get record :marker))))
           marimo-renderer--widgets)
  (recenter)
  (redisplay t)
  (let ((deadline (+ (float-time) 25)) value)
    (while (and (< (float-time) deadline)
                (not (and (stringp value) (string-match-p pattern value))))
      (sit-for 0.1)
      (setq value (marimo-test--javascript
                   widget (or script "window.marimoHost ? (window.marimoHost.error || window.marimoHost.text()) : document.body.innerText"))))
    (unless (and (stringp value) (string-match-p pattern value))
      (ert-fail (list :text value :page (marimo-test--javascript widget
                    "JSON.stringify({url: location.href, ready: document.readyState, html: document.documentElement.outerHTML.slice(0, 3000)})"))))
    (should (stringp value))
    (should (string-match-p pattern value))))

(ert-deftest marimo-renderer-selects-rich-output-and-preserves-native-images ()
  (dolist (output '((:mimetype "text/html" :data "<marimo-table></marimo-table>")
                    (:mimetype "text/markdown" :data "<marimo-plotly></marimo-plotly>")
                    (:mimetype "application/vnd.marimo+mimebundle" :data (:foo "bar"))))
    (should (marimo-renderer-needed-p (list :output output))))
  (dolist (output '(nil (:mimetype "text/html" :data "<table><tr><td>42</td></tr></table>")
                       (:mimetype "image/png" :data "AAAA")))
    (should-not (marimo-renderer-needed-p (list :output output))))
  (marimo-test--buffer
    (let ((marimo-renderer-assets-directory "/missing/marimo-renderer"))
      (marimo--render "b" '(:output (:mimetype "text/html" :data "<marimo-table></marimo-table>")))
      (should (string-match-p "marimo-install-renderer" (buffer-string)))))
  (let ((marimo-renderer-assets-directory "/missing/marimo-renderer"))
    (should-error (marimo-renderer--start) :type 'user-error)))

(ert-deftest marimo-renderer-layout-stays-above-minibuffer ()
  (with-temp-buffer
    (let ((marimo-renderer--widgets (make-hash-table :test #'equal))
          (top 480) resized)
      (puthash "cell" (list :widget 'fake :marker (point-marker) :width 768 :height 600)
               marimo-renderer--widgets)
      (cl-letf (((symbol-function 'window-live-p) (lambda (_) t))
                ((symbol-function 'window-buffer) (lambda (_) (current-buffer)))
                ((symbol-function 'window-body-height) (lambda (&rest _) 500))
                ((symbol-function 'window-body-width) (lambda (&rest _) 800))
                ((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) (list 0 top)))
                ((symbol-function 'xwidget-info) (lambda (_) [webkit "test" 768 600]))
                ((symbol-function 'xwidget-resize) (lambda (_ width height) (setq resized (list width height)))))
        (marimo-renderer--layout 'window)
        (should (equal resized '(768 18)))
        (setq top 520)
        (marimo-renderer--layout 'window)
        (should (equal resized '(768 0)))
        (setq top 0)
        (marimo-renderer--layout 'window)
        (should (equal resized '(768 498)))))))

(ert-deftest marimo-renderer-start-waits-for-an-existing-bridge ()
  (skip-unless (featurep 'xwidget-internal))
  (with-temp-buffer
    (let ((marimo-renderer--process 'starting) marimo-renderer--url waited)
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                ((symbol-function 'file-exists-p) (lambda (_) t))
                ((symbol-function 'executable-find) (lambda (_) "/node"))
                ((symbol-function 'process-live-p) (lambda (_) t))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _) (setq waited t marimo-renderer--url "http://127.0.0.1/ready/"))))
        (marimo-renderer--start)
        (should waited)
        (should marimo-renderer--url))
      (setq marimo-renderer--process nil))))

(ert-deftest marimo-renderer-routes-ui-only-to-own-kernel ()
  (marimo-test--buffer
    (let ((marimo-renderer--widgets (make-hash-table :test #'equal))
          (marimo--session "own-session") (marimo-renderer--process 'bridge) payload replies)
      (puthash "b" '(:widget fake) marimo-renderer--widgets)
      (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
                ((symbol-function 'process-send-string) (lambda (_ message) (push message replies)))
                ((symbol-function 'jsonrpc-async-request)
                 (lambda (_ _method params &rest callbacks)
                   (setq payload params)
                   (funcall (plist-get callbacks :success-fn) nil))))
        (marimo-renderer--request
         '(:cellId "b" :sessionId "own-session" :requestId 1 :command "update-ui-element"
                   :params (:kind "execute" :notebookUri "other" :kernelSessionId "other"
                                  :objectIds ["selector"] :values [["beta"]])))
        (should (equal (plist-get payload :kind) "update-ui-element"))
        (should (equal (plist-get payload :notebookUri) (marimo--uri)))
        (should (equal (plist-get payload :kernelSessionId) "own-session"))
        (setq payload nil)
        (marimo-renderer--request
         '(:cellId "b" :sessionId "retired" :requestId 2 :command "update-ui-element"))
        (should-not payload)
        (should (string-match-p "Stale renderer session" (car replies))))
      (clrhash marimo-renderer--widgets)
      (setq marimo-renderer--process nil))))

(ert-deftest marimo-renderer-integration-tables-plots-and-ui-roundtrip ()
  (skip-unless (and (getenv "MARIMO_TEST_SERVER") (getenv "MARIMO_TEST_RENDERER_ASSETS")))
  (let* ((marimo-server-command (list (getenv "MARIMO_TEST_SERVER")))
         (marimo-python-command (getenv "MARIMO_TEST_PYTHON"))
         (marimo-renderer-assets-directory (getenv "MARIMO_TEST_RENDERER_ASSETS"))
         (file (make-temp-file "marimo-rich-" nil ".py")) buffer assets)
    (unwind-protect
        (save-window-excursion
          (write-region
           (concat "import marimo\napp = marimo.App()\n"
                   "\n@app.cell\ndef setup():\n    import marimo as mo\n    import pandas as pd\n    import matplotlib.pyplot as plt\n    import plotly.express as px\n    import altair as alt\n    data = pd.DataFrame({'category': ['alpha', 'beta'], 'value': [1, 2]})\n    return mo, data, plt, px, alt\n"
                   "\n@app.cell\ndef table(mo, data):\n    selector = mo.ui.multiselect(['alpha', 'beta'], value=['alpha'], label='Pick category')\n    dropdown = mo.ui.dropdown(['alpha', 'beta'], value='alpha', label='Choose category', searchable=True)\n    mo.vstack([selector, dropdown, data])\n    return selector, dropdown\n"
                   "\n@app.cell\ndef selected(mo, selector, dropdown):\n    mo.md('Selected: ' + ','.join(selector.value) + ' Dropdown: ' + dropdown.value)\n    return\n"
                   "\n@app.cell\ndef matplotlib_plot(plt):\n    figure, axes = plt.subplots()\n    axes.plot([0, 1], [1, 2])\n    figure\n    return\n"
                   "\n@app.cell\ndef plotly_plot(px, data):\n    px.bar(data, x='category', y='value')\n    return\n"
                   "\n@app.cell\ndef altair_plot(alt, data):\n    alt.Chart(data).mark_bar().encode(x='category:N', y='value:Q')\n    return\n"
                   "\nif __name__ == '__main__':\n    app.run()\n")
           nil file nil 'silent)
          (setq buffer (find-file-noselect file))
          (pop-to-buffer buffer)
          (marimo-mode)
          (marimo-run-all)
          (marimo-test--wait
           (lambda () (and (not marimo--executing) (= (hash-table-count marimo--outputs) 6)
                           (cl-every (lambda (cell) (equal (plist-get (gethash (plist-get cell :id) marimo--outputs) :status) "idle"))
                                     (marimo--cells)))))
          (let* ((cells (marimo--cells))
                 (id (plist-get (nth 1 cells) :id))
                 (widget (plist-get (gethash id marimo-renderer--widgets) :widget))
                 (session marimo--session))
            (should widget)
            (marimo-test--web-ready widget "alpha")
            (marimo-test--web-ready widget "Pick category")
            (marimo-test--web-ready widget "2 rows, 2 columns")
            (should-not marimo-renderer--error)
            (dolist (index '(3 4 5))
              (let* ((plot-id (plist-get (nth index cells) :id))
                     (plot-widget (plist-get (gethash plot-id marimo-renderer--widgets) :widget)))
                (should plot-widget)
                (marimo-test--web-ready plot-widget "true"
                 "window.marimoHost?.error || String((function find(root) { if([...root.querySelectorAll('svg,canvas,img')].some(el => { const r = el.getBoundingClientRect(); return r.width > 20 && r.height > 80 && r.width * r.height > 5000; })) return true; return [...root.querySelectorAll('*')].some(el => el.shadowRoot && find(el.shadowRoot)); })(document.querySelector('#output')))")
                (should-not (marimo-test--javascript plot-widget "window.marimoHost.error"))))
            ;; Fontification must not erase the native display or its mouse target.
            (font-lock-flush)
            (font-lock-ensure)
            (let* ((record (gethash id marimo-renderer--widgets))
                   (marker (plist-get record :marker)))
              (should (overlay-buffer (plist-get record :overlay)))
              (should (eq widget (plist-get (cdr (get-char-property marker 'display)) :xwidget)))
              (goto-char marker)
              (recenter 2)
              (redisplay t)
              (marimo-renderer--layout (selected-window))
              (redisplay t)
              (let* ((view (xwidget-view-lookup widget (selected-window)))
                     (geometry (and view (xwidget-view-info view))))
                (should view)
                (should (<= (+ (aref geometry 1) (aref (xwidget-info widget) 3))
                            (nth 3 (window-inside-pixel-edges))))))
            ;; Use the actual component buttons and options, not a synthetic RPC.
            (dolist (tag '("marimo-dropdown" "marimo-multiselect"))
              (should (equal "opened"
               (marimo-test--javascript widget
                (format "(() => { const root = document.querySelector('%s').shadowRoot; const b = root.querySelector('button,[role=combobox],select'); if(!b) return root.innerHTML.slice(-3000); b.focus(); b.click(); return 'opened'; })()" tag))))
              (when (eq window-system 'ns)
                (should (marimo-test--javascript widget "xwHasFocus()")))
              (let ((option-script
                     "(() => { function find(root) { const option = [...root.querySelectorAll('[role=option]')].find(el => el.textContent.trim() === 'beta'); if(option) return option; for(const el of root.querySelectorAll('*')) { if(el.shadowRoot) { const found = find(el.shadowRoot); if(found) return found; } } } const option = find(document); return option; })()"))
                (marimo-test--web-ready widget "true" (concat "String(!!" option-script ")"))
                (should (marimo-test--javascript widget (concat option-script ".click(); true"))))
              (marimo-test--wait
               (lambda () (string-match-p (if (equal tag "marimo-dropdown") "Dropdown: beta" "Selected: alpha,beta")
                                          (buffer-string)))))
            (should (equal session marimo--session))
            (marimo--render id (gethash id marimo--outputs))
            (should (eq widget (plist-get (gethash id marimo-renderer--widgets) :widget)))
            (save-buffer)
            (let ((source (with-temp-buffer (insert-file-contents file) (buffer-string))))
              (should-not (string-match-p "RESULTS\\|marimoHost\\|begin_src" source)))
            (marimo-renderer--reset)
            (should-not (memq widget xwidget-list))
            (should-not (buffer-live-p (xwidget-buffer widget)))
            (should (= (hash-table-count marimo-renderer--widgets) 0)))
          (setq assets marimo--assets))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (when assets (delete-directory assets t))
      (delete-file file))))

