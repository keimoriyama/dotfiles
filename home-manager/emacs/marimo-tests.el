      (cl-letf (((symbol-function 'marimo--python) (lambda () "/venv/bin/python"))
                ((symbol-function 'jsonrpc-async-request)
                 (lambda (_ method params &rest _callbacks)
                   (should (eq method 'marimo/command)) (setq payload params))))
        (marimo--execute (list (car (marimo--cells))))
        (should (equal (plist-get payload :executable) "/venv/bin/python"))
        (should (= (length (plist-get payload :cells)) 1))
        (should-error (marimo--execute nil) :type 'user-error)))
    (goto-char (point-min))
    (insert "Outside cell\n\n")
    (goto-char (point-min))
    (should-error (marimo-run-cell) :type 'user-error)
    (should-error (marimo-interrupt) :type 'user-error)))

