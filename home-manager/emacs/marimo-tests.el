(ert-deftest marimo-wire-sync-retains-identity-without-saving ()
  (marimo-test--buffer
    (let ((marimo--connection 'fake) sent)
      (cl-letf (((symbol-function 'jsonrpc-notify)
                 (lambda (_ method params) (push (cons method params) sent))))
        (marimo--sync)
        (should (eq (caar sent) 'notebookDocument/didOpen))
        (should (= (length (plist-get (cdar sent) :cellTextDocuments)) 2))
        (marimo--sync)
        (should (= (length sent) 1))
        (let ((inhibit-modification-hooks t))
          (goto-char (point-min)) (search-forward "41") (replace-match "42"))
        (marimo--sync)
        (should (eq (caar sent) 'notebookDocument/didChange))
        (should (equal (plist-get (car (marimo--cells)) :id) "a"))
        (let ((buffer-file-name "/ssh:host:/tmp/a.py"))
          (should-error (marimo--uri) :type 'user-error))))))

(ert-deftest marimo-sync-deletion-reaches-live-kernel ()
