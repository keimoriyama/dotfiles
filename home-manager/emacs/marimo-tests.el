(ert-deftest marimo-output-updates-replace-drawer-without-dirtying-source ()
  (marimo-test--buffer
    (set-buffer-modified-p nil)
    (puthash "a" '(:submitted "x = 41\n") marimo--outputs)
    (marimo--cell-output '(:cell_id "a" :status "running" :console []))
    (marimo--cell-output '(:cell_id "a" :output (:mimetype "text/plain" :data "old")))
    (marimo--cell-output '(:cell_id "a" :output (:mimetype "text/plain" :data "new") :status "idle"))
    (should-not (buffer-modified-p))
    (should (= (length (marimo--cells)) 2))
    (should-not (string-match-p "old" (buffer-string)))
    (should (= (how-many "^#\\+RESULTS:" (point-min) (point-max)) 1))
    (should (string-match-p "new" (buffer-string))))
  (marimo-test--buffer
    (set-buffer-modified-p t)
    (marimo--render "missing" nil)
    (should (buffer-modified-p))))

(ert-deftest marimo-console-reset-append-and-ignore-null-output ()
  (marimo-test--buffer
    (marimo--cell-output '(:cell_id "a" :output (:mimetype "text/plain" :data "value")))
    (marimo--cell-output '(:cell_id "a" :output nil :console (:mimetype "text/plain" :data "one")))
    (marimo--cell-output '(:cell_id "a" :console (:mimetype "text/plain" :data "two")))
    (should (= (length (plist-get (gethash "a" marimo--outputs) :console)) 2))
    (should (equal (plist-get (plist-get (gethash "a" marimo--outputs) :output) :data) "value"))
    (marimo--cell-output '(:cell_id "a" :console [] :stale_inputs t))
    (should-not (plist-get (gethash "a" marimo--outputs) :console))
    (should (plist-get (gethash "a" marimo--outputs) :stale))
    (marimo--cell-output '(:cell_id "a" :stale_inputs :json-false))
    (should-not (plist-get (gethash "a" marimo--outputs) :stale))))

(ert-deftest marimo-results-do-not-corrupt-undo-of-following-cell ()
  (marimo-test--buffer
    (buffer-enable-undo)
    (setq buffer-undo-list nil)
    (goto-char (plist-get (cadr (marimo--cells)) :begin))
    (search-forward "x + 1")
    (replace-match "x + 2")
    (undo-boundary)
    (marimo--render "a" '(:status "idle" :output (:mimetype "text/plain" :data "result")))
    (let ((records buffer-undo-list) (buffer-undo-list t))
      (when (null (car records)) (pop records))
      (setq records (primitive-undo 1 records))
      (should (equal (plist-get (cadr (marimo--cells)) :code) "x + 2\n"))
      (when (null (car records)) (pop records))
      (primitive-undo 1 records)
      (should (equal (plist-get (cadr (marimo--cells)) :code) "x + 1\n")))))

(ert-deftest marimo-notifications-are-isolated-by-notebook-and-session ()
  (marimo-test--buffer
    (setq marimo--session "current" marimo--retired-sessions '("old"))
    (dolist (params (list
                     (list :notebookUri "file:///other.py" :sessionId "current")
                     (list :notebookUri (marimo--uri) :sessionId "old")
                     (list :notebookUri (marimo--uri) :sessionId "unrelated")))
      (marimo--notification 'marimo/kernelNotification
                            (append params '(:notification (:op "cell-op" :cell_id "a" :status "running")))))
    (should (= (hash-table-count marimo--outputs) 0))
    (marimo--notification 'marimo/kernelNotification
                          (list :notebookUri (marimo--uri) :sessionId "current"
                                :notification '(:op "cell-op" :cell_id "a" :status "running")))
    (should (equal (plist-get (gethash "a" marimo--outputs) :status) "running"))))

(ert-deftest marimo-formatting-is-safe-and-supports-html-tables ()
  (should (equal (marimo--format-output nil) ""))
  (should (string-match-p ",#\\+end_example" (marimo--example "#+end_example\n* attack")))
  (should (equal (marimo--example "\n") ""))
  (should (string-match-p ",:END:" (marimo--example ":END:")))
  (when (fboundp 'libxml-parse-html-region)
    (should (string-match-p "| a | 42 |"
                            (marimo--format-output
                             '(:mimetype "text/html" :data "<table><tr><td>a</td><td>42</td></tr></table>")))))
  (should (string-match-p "division" (marimo--format-output
                                      '(:channel "marimo-error" :data [(:msg "division by zero")])))))

(ert-deftest marimo-images-are-local-and-content-addressed ()
  (marimo-test--buffer
    (unwind-protect
        (let ((link (marimo--image "image/png" "aGVsbG8=")))
          (should (equal link (marimo--image "image/png" "aGVsbG8=")))
          (should (equal link (marimo--image "image/png" "data:image/png;base64,aGVsbG8%3D")))
          (should (= (length (directory-files marimo--assets nil "\\.png$")) 1))
          (should-error (marimo--image "image/png" "data:image/png;base64"))
          (should-error (marimo--image "image/unknown" "AA=="))
          (should-error (marimo--image "image/png" "%%%")))
      (when marimo--assets (delete-directory marimo--assets t)))))

(ert-deftest marimo-save-writes-python-and-preserves-source-on-failure ()
