(ert-deftest marimo-old-headings-migrate-without-changing-code-or-results ()
  (with-temp-buffer
    (marimo-mode)
    (insert "* first\n:PROPERTIES:\n:MARIMO_ID: a\n:MARIMO_NAME: first\n:MARIMO_CONFIG: {}\n:END:\n#+begin_src python\nx = 41\n#+end_src\n\n* second\n:PROPERTIES:\n:MARIMO_ID: b\n:MARIMO_NAME: second\n:MARIMO_CONFIG: {}\n:END:\n#+begin_src python\nx + 1\n#+end_src\n\n#+RESULTS:\n:results:\n42\n:end:\n")
    (goto-char (point-min))
    (search-forward "42")
    (let* ((marker (copy-marker (- (point) 2)))
           (overlay (make-overlay marker (+ marker 2))))
      (overlay-put overlay 'display '(space :width 10))
      (set-buffer-modified-p nil)
      (let ((cells (marimo--cells)))
        (should (equal (mapcar (lambda (cell) (plist-get cell :id)) cells) '("a" "b")))
        (should (equal (mapcar (lambda (cell) (plist-get cell :code)) cells) '("x = 41\n" "x + 1\n")))
        (should-not (org-element-map (org-element-parse-buffer) 'headline #'identity))
        (should-not (buffer-modified-p))
        (should (equal (buffer-substring-no-properties marker (+ marker 2)) "42"))
        (should (overlay-buffer overlay))
        (let ((before (buffer-string)))
          (marimo--cells)
          (should (equal before (buffer-string))))))))

